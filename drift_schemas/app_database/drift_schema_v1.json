  "fixed_sql": [
    {
      "name": "organizers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"organizers\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"bio\" TEXT NOT NULL, \"followers\" INTEGER NOT NULL CHECK(\"followers\" >= 0), \"events_count\" INTEGER NOT NULL CHECK(\"events_count\" >= 0), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"events\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"category\" TEXT NOT NULL, \"organizer_id\" TEXT NOT NULL REFERENCES organizers (id), \"starts_at\" TEXT NOT NULL, \"ends_at\" TEXT NOT NULL, \"time_zone\" TEXT NOT NULL, \"venue_name\" TEXT NULL, \"venue_address\" TEXT NULL, \"city\" TEXT NULL, \"join_url\" TEXT NULL, \"featured\" INTEGER NOT NULL DEFAULT 0 CHECK (\"featured\" IN (0, 1)), \"attendee_count\" INTEGER NOT NULL CHECK(\"attendee_count\" >= 0), \"capacity\" INTEGER NOT NULL CHECK(\"capacity\" > 0), \"status\" TEXT NOT NULL, \"previous_starts_at\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK (ends_at > starts_at), CHECK (attendee_count <= capacity), CHECK ((venue_name IS NOT NULL AND venue_address IS NOT NULL AND city IS NOT NULL AND join_url IS NULL) OR (venue_name IS NULL AND venue_address IS NULL AND city IS NULL AND join_url IS NOT NULL)));"
        }
      ]
    },
    {
      "name": "ticket_offers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ticket_offers\" (\"event_id\" TEXT NOT NULL REFERENCES events (id) ON DELETE CASCADE, \"type\" TEXT NOT NULL, \"price_minor\" INTEGER NOT NULL CHECK(\"price_minor\" >= 0), \"currency\" TEXT NOT NULL CHECK(LENGTH(\"currency\") = 3), \"capacity\" INTEGER NOT NULL CHECK(\"capacity\" > 0), \"remaining\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"event_id\", \"type\"), CHECK (remaining BETWEEN 0 AND capacity));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"event_id\" TEXT NOT NULL REFERENCES events (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"speaker\" TEXT NOT NULL, \"room\" TEXT NOT NULL, \"starts_at\" TEXT NOT NULL, \"ends_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (ends_at > starts_at));"
        }
      ]
    },
    {
      "name": "saved_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"saved_events\" (\"event_id\" TEXT NOT NULL REFERENCES events (id), \"saved_at\" TEXT NOT NULL, PRIMARY KEY (\"event_id\"));"
        }
      ]
    },
    {
      "name": "tickets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tickets\" (\"id\" TEXT NOT NULL, \"event_id\" TEXT NOT NULL REFERENCES events (id), \"code\" TEXT NOT NULL UNIQUE, \"type\" TEXT NOT NULL, \"note\" TEXT NOT NULL DEFAULT '', \"booked_at\" TEXT NOT NULL, \"cancelled_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
